// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  OWNER
  MANAGER
  STAFF
  CUSTOMER
}

enum StaffRole {
  OWNER
  MANAGER
  HOST
  SERVER
}

enum ReservationStatus {
  pending
  confirmed
  completed
  cancelled
}

model Restaurant {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  timezone    String   @default("UTC") // IANA timezone, e.g., "America/New_York"
  openingTime String // Local time in HH:MM format, e.g., "10:00"
  closingTime String // Local time in HH:MM format, e.g., "22:00"
  totalTables Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tables       Table[]
  reservations Reservation[]
  staff        RestaurantStaff[]
  waitlist     WaitlistEntry[]
  peakHours    PeakHours[]
}

model Table {
  id           Int @id @default(autoincrement())
  restaurantId Int
  number       Int
  capacity     Int

  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  reservations Reservation[]

  @@unique([restaurantId, number])
  @@index([restaurantId])
}

model Reservation {
  id              Int               @id @default(autoincrement())
  restaurantId    Int
  tableId         Int
  userId          String?
  customerName    String
  phone           String
  partySize       Int
  startTime       DateTime
  durationMinutes Int
  status          ReservationStatus @default(confirmed)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table      Table      @relation(fields: [tableId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([restaurantId, startTime])
  @@index([tableId, startTime])
  @@index([userId])
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  phone     String?
  role      UserRole @default(CUSTOMER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurants     RestaurantStaff[]
  refreshTokens   RefreshToken[]
  reservations    Reservation[]
  waitlistEntries WaitlistEntry[]
}

model RestaurantStaff {
  id           Int       @id @default(autoincrement())
  restaurantId Int
  userId       String
  role         StaffRole
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, userId])
  @@index([userId])
  @@index([restaurantId])
}

model RefreshToken {
  token     String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Waitlist entry for when no tables are available
model WaitlistEntry {
  id              Int            @id @default(autoincrement())
  restaurantId    Int
  userId          String?
  customerName    String
  email           String?
  phone           String
  partySize       Int
  preferredDate   DateTime // The date customer wants (UTC)
  preferredTime   String // Local time in HH:MM format, e.g., "18:30"
  flexibilityMins Int            @default(60) // How flexible they are (+/- minutes)
  durationMinutes Int
  status          WaitlistStatus @default(waiting)
  notifiedAt      DateTime?
  expiresAt       DateTime? // When this waitlist entry expires (UTC)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([restaurantId, preferredDate])
  @@index([restaurantId, status])
  @@index([userId])
}

enum WaitlistStatus {
  waiting
  notified
  converted
  expired
  cancelled
}

// Peak hours configuration per restaurant
model PeakHours {
  id                 Int      @id @default(autoincrement())
  restaurantId       Int
  dayOfWeek          Int // 0=Sunday, 1=Monday, ..., 6=Saturday
  startTime          String // Local time in HH:MM format, e.g., "18:00"
  endTime            String // Local time in HH:MM format, e.g., "21:00"
  maxDurationMinutes Int // Maximum reservation duration during peak hours
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, dayOfWeek, startTime])
  @@index([restaurantId, dayOfWeek])
}
